[Unit]
Description=Synchronize the Omni vault with Google Drive
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/rclone/rclone.conf
ConditionPathIsDirectory=%h/Documents/Omni

[Service]
Type=oneshot
ExecStart=%h/.nix-profile/bin/rclone bisync %h/Documents/Omni gdrive:Obsidian/Omni \
    --exclude=/.git/** \
    --exclude=/.trash/** \
    --check-access \
    --check-filename=.rclone-sync-check \
    --create-empty-src-dirs \
    --conflict-resolve=newer \
    --conflict-loser=num \
    --resilient \
    --recover \
    --stats-one-line
