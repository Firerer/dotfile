// layout_dir "~/.config/zellij/layouts/" // need to be absolute
//default_layout "compact" // "default" | "compact"
default_layout "compact"

//theme_dir "~/.config/zellij/themes/" // need to be absolute
// https://zellij.dev/documentation/theme-list.html
theme "tokyo-night"  // Default: default

simplified_ui true
default_shell "fish"
pane_frames false
scroll_buffer_size 1000000
// https://zellij.dev/documentation/options.html#copy_command
copy_command "xclip -selection clipboard"
copy_clipboard "primary"
copy_on_select true

plugins {
    tab-bar { path "tab-bar"; }
    status-bar { path "status-bar"; }
    // strider { path "strider"; } // folder viewer
    // compact-bar { path "compact-bar"; }
    compact-bar location="https://github.com/ivoronin/zellij-tab-bar-indexed/releases/latest/download/compact-bar.wasm" {
        show_tab_indices true
    }
}

// https://zellij.dev/documentation/keybindings-modes.html
keybinds clear-defaults=true {
    // Minimal Neovim-style bindings.
    // Daily actions are direct Alt bindings; less common pane actions live behind Alt-p.
    shared {
        bind "Alt g" { SwitchToMode "locked"; }  // guard/lock Zellij input
        bind "Alt r" { SwitchToMode "scroll"; }  // read scrollback
        bind "Alt p" { SwitchToMode "pane"; }    // pane management
    }

    normal {
        // Pane focus: Vim movement
        bind "Alt h" "Alt Left" { MoveFocusOrTab "Left"; }
        bind "Alt j" "Alt Down" { MoveFocus "Down"; }
        bind "Alt k" "Alt Up" { MoveFocus "Up"; }
        bind "Alt l" "Alt Right" { MoveFocusOrTab "Right"; }

        // Mouse-wheel-like scrollback without entering/leaving scroll mode
        bind "Alt PageUp" { HalfPageScrollUp; }
        bind "Alt PageDown" { HalfPageScrollDown; }
        bind "Alt Home" { ScrollToTop; }
        bind "Alt End" { ScrollToBottom; }

        // Tabs
        bind "Alt n" { NewTab; }
        bind "Alt t" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "Alt q" { CloseTab; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }

        // Panes
        bind "Alt v" { NewPane "Right"; } // vertical split
        bind "Alt s" { NewPane "Down"; }  // horizontal split
        bind "Alt x" "Alt d" { CloseFocus; }
        // bind "Alt f" { ToggleFocusFullscreen; }
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
    }

    locked {
        bind "Alt g" { SwitchToMode "normal"; }
    }

    scroll {
        bind "q" "Esc" { SwitchToMode "normal"; }
        bind "e" { EditScrollback; SwitchToMode "normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "u" { HalfPageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "b" { PageScrollUp; }
        bind "f" { PageScrollDown; }
        bind "g" { ScrollToTop; }
        bind "G" { ScrollToBottom; }
        bind "/" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "n" { Search "Down"; }
        bind "N" { Search "Up"; }
    }

    search {
        bind "q" "Esc" { SwitchToMode "scroll"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "f" "PageDown" { PageScrollDown; }
        bind "b" "PageUp" { PageScrollUp; }
        bind "n" { Search "Down"; }
        bind "N" { Search "Up"; }
        bind "/" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }

    entersearch {
        bind "Enter" { SwitchToMode "search"; }
        bind "Ctrl c" "Esc" { SearchInput 27; SwitchToMode "scroll"; }
    }

    pane {
        bind "q" "Esc" "Alt p" { SwitchToMode "normal"; }

        // Move panes around with Vim movement
        bind "h" "Left" { MovePane "Left"; }
        bind "j" "Down" { MovePane "Down"; }
        bind "k" "Up" { MovePane "Up"; }
        bind "l" "Right" { MovePane "Right"; }

        bind "p" { SwitchFocus; }
        bind "v" { NewPane "Right"; SwitchToMode "normal"; }
        bind "s" { NewPane "Down"; SwitchToMode "normal"; }
        bind "x" { CloseFocus; SwitchToMode "normal"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "normal"; }
        bind "r" { SwitchToMode "RenamePane"; PaneNameInput 0; }
        bind "z" { TogglePaneFrames; SwitchToMode "normal"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "normal"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "normal"; }
        bind "i" { TogglePanePinned; SwitchToMode "normal"; }

        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }

    RenameTab {
        bind "Enter" { SwitchToMode "normal"; }
        bind "Ctrl c" "Esc" { UndoRenameTab; SwitchToMode "normal"; }
    }

    RenamePane {
        bind "Enter" { SwitchToMode "normal"; }
        bind "Ctrl c" "Esc" { UndoRenamePane; SwitchToMode "pane"; }
    }
}

