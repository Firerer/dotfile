#!/usr/bin/env bash

set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
lock_file="${runtime_dir}/omni-google-drive-bisync.lock"

exec 9>"$lock_file"
flock -n 9 || exit 0

# Authentication remains in the untracked ~/.config/rclone/rclone.conf.
exec rclone bisync \
	"${HOME}/Documents/Omni" \
	gdrive:Obsidian/Omni \
	--exclude '/.git/**' \
	--exclude '/.trash/**' \
	--check-access \
	--check-filename '.rclone-sync-check' \
	--create-empty-src-dirs \
	--conflict-resolve newer \
	--conflict-loser num \
	--resilient \
	--recover \
	--stats-one-line
