language = en

# ----------------------------------------
# style
# ----------------------------------------
# ghostty +list-fonts
font-family = "CodeNewRoman Nerd Font"
font-size = 18
cursor-style = bar

window-decoration = none
window-subtitle = working-directory

window-padding-x = 0
window-padding-y = 0
window-padding-color = extend
window-step-resize = true

gtk-titlebar-style = tabs
gtk-toolbar-style = raised-border
fullscreen = true

# ghostty +list-themes
theme = Doom One
window-theme = ghostty
gtk-custom-css = custom.css

# ----------------------------------------
# shell behavior
# ----------------------------------------

command = fish
shell-integration = fish
working-directory = ~/Projects/
tab-inherit-working-directory = true
split-inherit-working-directory = true
copy-on-select = true

# ----------------------------------------
# General Tab & Pane Management
# ----------------------------------------
# New tab
keybind = alt+t=new_tab
# Delete current pane (closes the active split, or the tab if it's the last split)
keybind = alt+q=close_surface
confirm-close-surface = false
keybind = alt+r=reload_config

keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=goto_tab:9
keybind = alt+0=last_tab
keybind = alt+shift+j=previous_tab
keybind = alt+shift+k=next_tab

keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right

keybind = alt+shift+h=move_tab:-1
keybind = alt+shift+l=move_tab:1

keybind = alt+ctrl+j=new_split:down
keybind = alt+ctrl+k=new_split:up
keybind = alt+ctrl+h=new_split:left
keybind = alt+ctrl+l=new_split:right

