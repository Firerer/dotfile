{
  "diagnostics.disable": [
    "missing-fields"
  ],
  "diagnostics.globals": [
    "vim",
    "g_last_modification_time"
  ],
  "runtime.version": "LuaJIT",
  "runtime.path": [
    "lua/?.lua",
    "lua/?/init.lua"
  ],
  "workspace.checkThirdParty": false,
  "workspace.library": [
    "$VIMRUNTIME",
    "${3rd}/luv/library"
  ]
}
